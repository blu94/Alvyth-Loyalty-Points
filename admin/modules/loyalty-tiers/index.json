{
  "expandable": false,
  "headerActions": {
    "elements": [
      {
        "key": "reload",
        "ui": {
          "type": "button",
          "icon": "tabler-refresh",
          "color": "success",
          "rounded": true
        },
        "tooltip": "Refresh List",
        "action": "reload",
        "class": "ms-2"
      },
      {
        "key": "create",
        "ui": {
          "type": "button",
          "icon": "tabler-plus",
          "color": "primary",
          "rounded": "md"
        },
        "label": "New Tier",
        "tooltip": "Click to add a new loyalty tier",
        "action": "navigate",
        "to": "/module/loyalty-tiers/create"
      }
    ]
  },
  "filters": {
    "elements": [
      {
        "ui": { "type": "field" },
        "key": "status",
        "label": "Status",
        "placeholder": "Select Status",
        "type": "select",
        "options": {
          "url": "/admin/modules/loyalty-tiers/options",
          "master": "status"
        }
      }
    ]
  },
  "elements": [
    {
      "ui": { "type": "display" },
      "label": "ID",
      "key": "id",
      "sortable": true,
      "width": "60px"
    },
    {
      "ui": { "type": "display" },
      "label": "Tier",
      "key": "title",
      "sortable": true,
      "searchable": true
    },
    {
      "ui": { "type": "display" },
      "label": "Points needed",
      "key": "threshold",
      "sortable": true
    },
    {
      "ui": { "type": "display" },
      "label": "Status",
      "key": "status",
      "sortable": false,
      "align": "center",
      "type": "status"
    },
    {
      "ui": { "type": "display" },
      "label": "Created At",
      "key": "created_at",
      "sortable": true,
      "align": "center",
      "type": "datetime"
    }
  ],
  "actions": {
    "elements": [
      "edit",
      {
        "key": "delete",
        "action": "delete",
        "ui": {
          "type": "button",
          "icon": "tabler-trash",
          "color": "error",
          "rounded": true
        },
        "params": {
          "confirm": true,
          "confirmText": "Are you sure you want to delete this loyalty tier?"
        }
      }
    ],
    "class": "fit"
  }
}
