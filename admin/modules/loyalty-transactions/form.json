{
  "elements": [
    {
      "ui": { "type": "section", "cols": 12, "icon": "tabler-arrows-exchange" },
      "name": "Ledger Entry",
      "subtitle": "Award, redeem or correct a member's points. The member's balance and tier are recalculated when this is saved.",
      "elements": [
        {
          "ui": { "type": "field", "cols": 12 },
          "key": "member_id",
          "type": "autocomplete",
          "label": "Member",
          "placeholder": "Search enrolled customers",
          "hint": "Only enrolled customers appear here — enrol them under Loyalty first.",
          "options": {
            "url": "/admin/modules/loyalty-members",
            "master": "data",
            "map": { "title": "user.name", "value": "id" }
          },
          "rules": ["required", "integer", "exists:loyalty_members,id"]
        },
        {
          "ui": { "type": "field", "cols": 6 },
          "key": "type",
          "type": "select",
          "label": "Type",
          "default": "earn",
          "hint": "Redeem and Expire subtract points — enter a positive number and the sign is applied for you. Adjust keeps the sign you type.",
          "options": {
            "items": [
              { "title": "Earn", "value": "earn" },
              { "title": "Redeem", "value": "redeem" },
              { "title": "Adjust", "value": "adjust" },
              { "title": "Expire", "value": "expire" }
            ]
          },
          "rules": ["required", "in:earn,redeem,adjust,expire"]
        },
        {
          "ui": { "type": "field", "cols": 6 },
          "key": "points",
          "type": "number",
          "label": "Points",
          "placeholder": "e.g. 250",
          "rules": ["required", "integer"]
        },
        {
          "ui": { "type": "field", "cols": 12 },
          "key": "reason",
          "type": "text",
          "label": "Reason",
          "placeholder": "e.g. Order ORD-000123, goodwill gesture, expired 2026 balance",
          "hint": "Shown on the activity list. Worth filling in — it is the only record of why the points moved.",
          "rules": ["nullable", "max:255"]
        },
        {
          "ui": { "type": "field", "cols": 12 },
          "key": "order_id",
          "type": "number",
          "label": "Order ID",
          "placeholder": "Optional",
          "hint": "Links this entry to an order for reference. Kept even if the order is later deleted.",
          "rules": ["nullable", "integer", "min:1"]
        }
      ]
    }
  ],
  "sidebar": {
    "elements": [
      {
        "ui": { "type": "row", "dense": true },
        "elements": [
          {
            "ui": { "type": "field" },
            "key": "created_at",
            "type": "display",
            "label": "Recorded"
          }
        ]
      }
    ],
    "footer": {
      "elements": [
        {
          "ui": { "type": "row", "dense": true },
          "elements": [
            {
              "ui": { "type": "button", "color": "primary", "icon": "tabler-checkbox" },
              "action": "save",
              "label": "Save Entry",
              "redirect": false
            },
            {
              "ui": { "type": "button", "color": "secondary", "variant": "tonal", "icon": "tabler-arrow-left" },
              "action": "cancel",
              "label": "Cancel",
              "redirect": "/module/loyalty-transactions"
            }
          ]
        }
      ]
    }
  }
}
